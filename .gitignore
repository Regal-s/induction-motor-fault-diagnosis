dataset/windows.npy

# Python
__pycache__/
*.pyc
*.pyo

# Logs / temp
dataset/dl_run.log
*.log

# Local Claude Code settings (machine-specific, not project work)
.claude/

# Reference papers (PDFs, copyrighted) — keep synthesized notes only
papers/*.pdf

# Experimental data (cloned repo + generated arrays) — keep the loader scripts
experimental/ITSC/
experimental/ibarram/
# LaTeX build artifacts & engine binary
manuscript/tectonic.exe
manuscript/*.log
manuscript/*.xdv
manuscript/*.aux
manuscript/*.out

# SCST tensor arrays (large, regenerable via scst.py)
dataset/scst/*.npy

# Reference-format PDF (third-party, format reference only)
Final_Submission.pdf

# Office lock files
~$*

# Backup files
*.bak.*
*.prebenchmark.bak.*
*.prerewrite.bak.*

# Per-version PDF/TeX side files from iterative compilation
manuscript/main_v*.pdf
manuscript/main_v*.tex
manuscript/main.tex.preorder
manuscript/figs_png/

# Reference paper text dumps (kept locally, large)
papers/*.txt

# Large trained PyTorch weights (>50 MB) -- regenerable via save_all_models.py
trained_models/**/*.large.pt
